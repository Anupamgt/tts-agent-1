{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://shots-neighbors-recovery-equipment.trycloudflare.com/api/:path*" },
    { "source": "/healthz", "destination": "https://shots-neighbors-recovery-equipment.trycloudflare.com/healthz" },
    { "source": "/phone", "destination": "https://shots-neighbors-recovery-equipment.trycloudflare.com/phone.html" },
    { "source": "/console", "destination": "https://shots-neighbors-recovery-equipment.trycloudflare.com/?live=1" },
    { "source": "/js/:path*", "destination": "https://shots-neighbors-recovery-equipment.trycloudflare.com/js/:path*" },
    { "source": "/fonts/:path*", "destination": "https://shots-neighbors-recovery-equipment.trycloudflare.com/fonts/:path*" },
    { "source": "/console.css", "destination": "https://shots-neighbors-recovery-equipment.trycloudflare.com/console.css" },
    { "source": "/brand/:path*", "destination": "https://shots-neighbors-recovery-equipment.trycloudflare.com/brand/:path*" }
  ],
  "headers": [
    { "source": "/phone", "headers": [{ "key": "Permissions-Policy", "value": "microphone=(self)" }] }
  ]
}
