# Copy to the repo root as .env when the API exists. Do not commit .env.
# Every value here is a local default. Bolna's key is the only real secret.

BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_TOOL_TOKEN=dev-tool-token-change-me
BOLNA_WEBHOOK_TOKEN=dev-webhook-token-change-me
# Set to 1 only when the tunnel is public and you have confirmed Bolna's source IPs.
BOLNA_ENFORCE_SOURCE_IP=0

DESK_PIN=2468
PUBLIC_BASE_URL=http://127.0.0.1:8000
SIMULATOR_ENABLED=1

DATABASE_URL=postgresql://clinic:clinic@127.0.0.1:5432/clinic
REDIS_URL=redis://127.0.0.1:6379/0
# Host tools use localhost. Containers use kafka:19092. There is no public broker address.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:19092

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# whisper runs on this machine. sarvam or deepgram need a key and are better for Hindi.
STT_PROVIDER=whisper
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
