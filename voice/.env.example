# --- LiveKit (Cloud is simplest: it includes SIP; self-hosted needs livekit-sip too)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=deskie

# --- Gnani AI (Prisma STT + Timbre TTS), key from the Gnani API dashboard
GNANI_API_KEY=
GNANI_STT_LANGUAGE=en-IN
GNANI_STT_SAMPLE_RATE=16000
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Poorvi
GNANI_TTS_LANGUAGE=auto
GNANI_TTS_METHOD=sse

# --- Evon v3.3 served OpenAI-compatible (vLLM / SGLang), with tool calling on:
#   vllm serve gnani/gnani-evon-v3.3-30B-A3B --port 8100 --max-model-len 32768 --trust-remote-code --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser nano_v3
EVON_BASE_URL=http://127.0.0.1:8100/v1
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_API_KEY=none
EVON_TEMPERATURE=0.2
# 1 = let Evon reason before answering (slower). 0 for calls.
EVON_THINKING=0
# 0 when EVON_BASE_URL points at a non-vLLM OpenAI-compatible fallback.
EVON_EXTRA_BODY=1

# --- Clinic backend (api/). Same tokens the backend checks on /v1/tools and the webhook.
DESK_API_BASE=http://127.0.0.1:8000
TOOL_TOKEN=
WEBHOOK_TOKEN=
CLINIC_NAME=Deskie
# Caller number used for browser calls that carry no phone attribute.
DEMO_CALLER_NUMBER=+919876543210
WELCOME_LANGUAGE=en
# Optional: SIP REFER the caller to this number once the desk accepts a handoff.
TRANSFER_TO_NUMBER=

# --- Vobiz SIP trunk (Vobiz console > SIP trunks)
VOBIZ_NUMBER=+91XXXXXXXXXX
VOBIZ_SIP_DOMAIN=xxxxxxxx.sip.vobiz.ai
VOBIZ_USERNAME=
VOBIZ_PASSWORD=
# Only if the Vobiz trunk sends digest credentials on inbound calls:
VOBIZ_INBOUND_USERNAME=
VOBIZ_INBOUND_PASSWORD=
# Printed by `python sip_setup.py outbound`
SIP_OUTBOUND_TRUNK_ID=
