[
  {
    "name": "lookup_caller",
    "description": "How many patient files are on the calling number. Returns a count only, never names.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        }
      },
      "required": [
        "call_id"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/lookup_caller",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s"
      }
    }
  },
  {
    "name": "match_patient",
    "description": "Verify the caller with full name plus the patient id on the card, or full name plus date of birth. Call this before any patient-specific fact or change.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "full_name": {
          "type": "string",
          "description": "Patient full name, as spoken."
        },
        "patient_code": {
          "type": "string",
          "description": "Id printed on the card, as spoken. Omit if they do not know it."
        },
        "date_of_birth": {
          "type": "string",
          "description": "YYYY-MM-DD. Only when the id is unknown."
        },
        "phone_last4": {
          "type": "string",
          "description": "Last four digits of the registered mobile. Only if the previous result asked for them."
        },
        "caller_is_patient": {
          "type": "boolean",
          "description": "False when a relative or someone else is calling for the patient."
        }
      },
      "required": [
        "call_id",
        "full_name"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/match_patient",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s",
        "full_name": "%(full_name)s",
        "patient_code": "%(patient_code)s",
        "date_of_birth": "%(date_of_birth)s",
        "phone_last4": "%(phone_last4)s",
        "caller_is_patient": "%(caller_is_patient)s"
      }
    },
    "pre_call_message": "One moment, I am checking the file."
  },
  {
    "name": "register_patient",
    "description": "Create a file for a new patient who wants to book. Only after two failed matches, or when the caller says they are new. The phone number is taken from the line, never from the caller.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "full_name": {
          "type": "string",
          "description": "New patient's full name."
        },
        "date_of_birth": {
          "type": "string",
          "description": "YYYY-MM-DD, if known."
        },
        "age_years": {
          "type": "string",
          "description": "Age in years, if the date of birth is not known."
        }
      },
      "required": [
        "call_id",
        "full_name"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/register_patient",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s",
        "full_name": "%(full_name)s",
        "date_of_birth": "%(date_of_birth)s",
        "age_years": "%(age_years)s"
      }
    },
    "pre_call_message": "One moment, please."
  },
  {
    "name": "get_clinic_info",
    "description": "Clinic facts: opening hours, address, fees, priority fee, payment options, refund rules, or the list of doctors. No verification needed.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "topic": {
          "type": "string",
          "description": "Which fact.",
          "enum": [
            "hours",
            "address",
            "fees",
            "priority_fee",
            "payment",
            "refunds",
            "doctors"
          ]
        }
      },
      "required": [
        "call_id",
        "topic"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/get_clinic_info",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s",
        "topic": "%(topic)s"
      }
    }
  },
  {
    "name": "get_doctor_delay",
    "description": "Whether a doctor is running late today. No verification needed.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "doctor_name": {
          "type": "string",
          "description": "Doctor's name as spoken."
        }
      },
      "required": [
        "call_id",
        "doctor_name"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/get_doctor_delay",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s",
        "doctor_name": "%(doctor_name)s"
      }
    },
    "pre_call_message": "One moment, please."
  },
  {
    "name": "get_available_windows",
    "description": "Open arrival windows for one doctor, or for the general check-up pool when any doctor is fine. Verified callers only.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "doctor_name": {
          "type": "string",
          "description": "Doctor's name, for a named doctor or a specialist."
        },
        "pool_name": {
          "type": "string",
          "description": "Use 'General check-up' when any doctor is fine."
        }
      },
      "required": [
        "call_id"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/get_available_windows",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s",
        "doctor_name": "%(doctor_name)s",
        "pool_name": "%(pool_name)s"
      }
    },
    "pre_call_message": "One moment, please."
  },
  {
    "name": "hold_window",
    "description": "Hold the chosen arrival window for 90 seconds while the caller confirms. States any fee that needs a yes.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "window_id": {
          "type": "string",
          "description": "window_id from get_available_windows."
        },
        "any_doctor": {
          "type": "boolean",
          "description": "True for the general check-up pool."
        },
        "priority": {
          "type": "boolean",
          "description": "True only for a priority visit the caller asked for."
        }
      },
      "required": [
        "call_id",
        "window_id"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/hold_window",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s",
        "window_id": "%(window_id)s",
        "any_doctor": "%(any_doctor)s",
        "priority": "%(priority)s"
      }
    },
    "pre_call_message": "One moment, please."
  },
  {
    "name": "create_booking",
    "description": "Book the chosen window after a clear yes to the window and, when there is a fee, a clear yes to the amount.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "window_id": {
          "type": "string",
          "description": "Same window_id as the hold."
        },
        "fee_consent": {
          "type": "boolean",
          "description": "True only if the caller said yes to the fee amount."
        },
        "payment_method": {
          "type": "string",
          "description": "How the fee is paid.",
          "enum": [
            "upi_link",
            "cash_desk"
          ]
        },
        "priority": {
          "type": "boolean",
          "description": "True only for a priority visit."
        },
        "any_doctor": {
          "type": "boolean",
          "description": "True for the general check-up pool."
        },
        "visit_type": {
          "type": "string",
          "description": "Kind of visit.",
          "enum": [
            "first_visit",
            "follow_up",
            "general_checkup",
            "other"
          ]
        }
      },
      "required": [
        "call_id",
        "window_id"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/create_booking",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s",
        "window_id": "%(window_id)s",
        "fee_consent": "%(fee_consent)s",
        "payment_method": "%(payment_method)s",
        "priority": "%(priority)s",
        "any_doctor": "%(any_doctor)s",
        "visit_type": "%(visit_type)s"
      }
    },
    "pre_call_message": "One moment, I am booking it."
  },
  {
    "name": "reschedule_booking",
    "description": "Move the caller's own visit to a new arrival window after a clear yes.",
