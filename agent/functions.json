  {
    "name": "set_disposition",
    "description": "Record how the call ended. Call exactly once, just before the goodbye.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "disposition": {
          "type": "string",
          "description": "Outcome.",
          "enum": [
            "booked",
            "rescheduled",
            "cancelled",
            "info_provided",
            "ticket_created",
            "callback_queued",
            "transferred_to_human",
            "emergency_redirected",
            "verification_failed",
            "out_of_scope",
            "abandoned"
          ]
        }
      },
      "required": [
        "call_id",
        "disposition"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/set_disposition",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s",
        "disposition": "%(disposition)s"
      }
    }
  }
