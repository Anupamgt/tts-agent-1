  {
    "name": "request_human",
    "description": "Bring someone from the desk into the call. The prompt says the hand-over line itself, so there is no pre-call message.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "priority": {
          "type": "string",
          "description": "P1 emergency or self-harm, P2 distress or a failed booking, P3 everything else.",
          "enum": [
            "P1",
            "P2",
            "P3"
          ]
        },
        "reason": {
          "type": "string",
          "description": "Short reason for the desk."
        }
      },
      "required": [
        "call_id",
        "priority",
        "reason"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/request_human",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s",
        "priority": "%(priority)s",
        "reason": "%(reason)s"
      }
    },
