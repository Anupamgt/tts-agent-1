  {
    "name": "create_message_ticket",
    "description": "Pass a message, or a medicine refill request, to the doctor or desk. Never a decision.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "type": {
          "type": "string",
          "description": "Kind of request.",
          "enum": [
            "message",
            "refill",
            "report_query"
          ]
        },
        "body": {
          "type": "string",
          "description": "Short message in the caller's words. Nothing clinical added."
        },
        "doctor_name": {
          "type": "string",
          "description": "Doctor the message or medicine is for."
        },
        "medicine_name": {
          "type": "string",
          "description": "Refills: the name exactly as read from the strip."
        },
        "days_left": {
          "type": "string",
          "description": "Refills: days of medicine left, as a number."
        },
        "requester_is_guardian": {
          "type": "boolean",
          "description": "Refills for a child: true only if the caller said they are the parent or guardian."
        },
        "new_symptoms_mentioned": {
          "type": "boolean",
          "description": "True if the caller mentioned new or worse symptoms."
        }
      },
      "required": [
        "call_id",
        "type"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/create_message_ticket",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s",
        "type": "%(type)s",
        "body": "%(body)s",
        "doctor_name": "%(doctor_name)s",
        "medicine_name": "%(medicine_name)s",
        "days_left": "%(days_left)s",
        "requester_is_guardian": "%(requester_is_guardian)s",
        "new_symptoms_mentioned": "%(new_symptoms_mentioned)s"
      }
    },
    "pre_call_message": "One moment, please."
  },
  {
    "name": "create_callback",
    "description": "Ask the desk to call the caller back. P1 emergency or self-harm, P2 same day, P3 next session.",
    "parameters": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "priority": {
          "type": "string",
          "description": "Callback priority.",
          "enum": [
            "P1",
            "P2",
            "P3"
          ]
        },
        "reason": {
          "type": "string",
          "description": "Short reason for the desk."
        },
        "phone": {
          "type": "string",
          "description": "Only if the caller asks for a different Indian mobile number, +91 and 10 digits."
        }
      },
      "required": [
        "call_id",
        "priority",
        "reason"
      ]
    },
    "key": "custom_task",
    "value": {
      "method": "POST",
      "url": "https://PUBLIC_BASE/v1/tools/create_callback",
      "api_token": "Bearer TOKEN",
      "param": {
        "call_id": "%(call_id)s",
        "priority": "%(priority)s",
        "reason": "%(reason)s",
        "phone": "%(phone)s"
      }
    }
  },
