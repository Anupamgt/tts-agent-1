      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "description": "The call reference from the prompt. Do not ask the caller."
        },
        "booking_id": {
          "type": "string",
          "description": "booking_id from get_booking_status."
        },
        "window_id": {
          "type": "string",
          "description": "New window_id."
        }
      },
      "required": [
        "call_id",
        "booking_id",
